{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:with-api": "concurrently --kill-others-on-fail -n api,vite -c blue,green \"node scripts/spawn-local-api.mjs\" \"vite --host 127.0.0.1 --port 5173\"",
    "build": "tsc -b && vite build",
    "build:serve-ui-test": "tsc -b && vite build --mode serve-ui-test",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:tree-regression": "playwright test tests/tree-regression.spec.ts",
    "test:tree-regression:update": "playwright test tests/tree-regression.spec.ts --update-snapshots",
    "test:tree-regression:report": "playwright show-report playwright-report/tree-regression",
    "test:nav-walkthrough": "playwright test tests/nav-walkthrough.spec.ts",
    "test:rbac-nav": "playwright test tests/rbac-nav.spec.ts -c playwright.rbac.config.ts",
    "test:flags-rules": "playwright test tests/flags-rules.spec.ts -c playwright.flags-rules.config.ts",
    "test:deep-link-audit-flag": "playwright test tests/deep-link-audit-flag.spec.ts -c playwright.deep-link.config.ts",
    "test:package-d": "playwright test tests/package-d-profile-drill.spec.ts -c playwright.package-d.config.ts",
    "test:dplus": "playwright test tests/dplus-analysis.spec.ts -c playwright.dplus.config.ts",
    "test:compare-charts-drill": "playwright test tests/compare-charts-drill.spec.ts"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
