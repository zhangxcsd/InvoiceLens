# 格式检测：单文件大小上限（MB）。金税导出可能超过 100MB，可按需调高（上限 2048）。
VITE_MAX_IMPORT_FILE_MB=200
#
# 可选：直连本地 API 完整地址（不设则 npm run dev 时用同源 /api，由 Vite 代理到 8765）。
# VITE_LOCAL_API_BASE=http://127.0.0.1:8765
#
# 本地 API 侧请同步（项目根目录 dev.bat api / dev.bat 前设置）：
# INVOICELENS_MAX_UPLOAD_MB=200
# 未设置时：分文件上传单次请求≈单文件+32MB；若仍调用旧接口一次传多文件，未设本变量时整包默认 2048MB
# INVOICELENS_MAX_MULTIPART_BODY_MB=512
#
# 生产构建（npm run build）下：若本地 API 不可用，「开始导入」默认不再静默走模拟流程。
# 需要无 API 演示打包时设为 true：
# VITE_IMPORT_SIM_ON_FAIL=true
